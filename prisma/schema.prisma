generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  emailVerified    DateTime?
  image            String?
  password         String?
  role             String    @default("JOBSEEKER")
  suspended        Boolean   @default(false)
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  profile         JobSeekerProfile?
  company         Company?
  applications    Application[]
  savedJobs       SavedJob[]
  reviews         CompanyReview[]
  blogPosts       BlogPost[]
  recruiterNotes  RecruiterNote[]
  jobAlerts       JobAlert[]
  activityLogs    ActivityLog[]

  @@index([role])
  @@index([suspended])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model JobSeekerProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  title            String?
  bio              String?
  phone            String?
  location         String?
  cv               String?
  cvPublic         Boolean  @default(false)
  skills           String?
  experience       String?
  education        String?
  smsOptIn         Boolean  @default(false)
  whatsappOptIn    Boolean  @default(false)
  notifCategories  String?  // JSON array de secteurs, null = tous les secteurs
  isDisabled       Boolean  @default(false) // Statut de travailleur handicapé (RQTH)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cvViews CvView[]
}

model CvView {
  id          String   @id @default(cuid())
  profileId   String
  viewerId    String
  companyName String?
  viewedAt    DateTime @default(now())

  profile JobSeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([profileId, viewedAt])
  @@index([viewerId])
}

model Company {
  id             String   @id @default(cuid())
  userId         String   @unique
  name           String
  slug           String   @unique
  logo           String?
  website        String?
  description    String?
  sector         String?
  size           String?
  location       String?
  phone          String?
  email          String?
  banner         String?
  videoUrl       String?
  photos         String?
  foundedYear    Int?
  verified       Boolean  @default(false)
  superRecruiter Boolean  @default(false)
  suspended      Boolean  @default(false)
  allowContact   Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs         Job[]
  reviews      CompanyReview[]
  jobTemplates JobTemplate[]
  subscription Subscription?

  @@index([verified])
  @@index([suspended])
  @@index([sector])
}

model Subscription {
  id            String    @id @default(cuid())
  companyId     String    @unique
  plan          String    @default("FREE")
  status        String    @default("ACTIVE")
  startDate     DateTime  @default(now())
  endDate       DateTime?
  paymentRef    String?
  paymentMethod String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([plan, status])
}

model Job {
  id              String    @id @default(cuid())
  companyId       String
  title           String
  slug            String    @unique
  description     String
  requirements    String?
  benefits        String?
  type            String
  category        String
  location        String
  remote          Boolean   @default(false)
  salaryMin       Int?
  salaryMax       Int?
  salaryCurrency  String    @default("XAF")
  experienceLevel String?
  deadline        DateTime?
  coverImage          String?
  published           Boolean   @default(true)
  featured            Boolean   @default(false)
  notifyOnApproval    Boolean   @default(false)
  views           Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications Application[]
  savedBy      SavedJob[]

  // Index simples
  @@index([companyId])
  @@index([published])
  @@index([featured])
  @@index([category])
  @@index([location])
  @@index([type])
  @@index([createdAt])
  // Index composés pour les requêtes courantes
  @@index([published, createdAt])         // liste des offres triée
  @@index([published, featured, createdAt]) // page d'accueil
  @@index([published, category])          // filtre par secteur
  @@index([published, location])          // filtre par ville
  @@index([published, type])              // filtre par type de contrat
}

model Application {
  id               String    @id @default(cuid())
  jobId            String
  userId           String
  coverLetter      String?
  cvUrl            String?
  status           String    @default("PENDING")
  responseDeadline DateTime?            // Date limite de réponse du recruteur (J+10)
  remindersSent    Int       @default(0) // Nb de rappels envoyés (0=aucun, 1=J-7, 2=J-3, 3=J-1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  job           Job                        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user          User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes         RecruiterNote[]
  statusHistory ApplicationStatusHistory[]

  @@unique([jobId, userId])
  @@index([userId])
  @@index([jobId])
  @@index([status])
  @@index([userId, createdAt])   // historique candidatures d'un user
  @@index([jobId, status])       // candidatures d'une offre par statut
}

model ApplicationStatusHistory {
  id            String   @id @default(cuid())
  applicationId String
  status        String
  note          String?
  changedAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model SavedJob {
  id        String   @id @default(cuid())
  jobId     String
  userId    String
  createdAt DateTime @default(now())

  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@index([userId])
}

model Report {
  id         String   @id @default(cuid())
  type       String
  targetId   String
  reason     String
  details    String?
  reporterId String?
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())

  @@index([status])
  @@index([type, status])
}

model SiteSetting {
  key   String @id
  value String
}

model RecruiterNote {
  id            String   @id @default(cuid())
  applicationId String
  recruiterId   String
  content       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  recruiter   User        @relation(fields: [recruiterId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([recruiterId])
}

model CompanyReview {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  rating    Int
  pros      String?
  cons      String?
  anonymous Boolean  @default(true)
  status    String   @default("APPROVED")
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([companyId, status])
}

model BlogPost {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  excerpt   String?
  content   String
  category  String   @default("Conseils")
  published Boolean  @default(true)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([published, createdAt])
}

model RecruitmentEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime
  location    String?
  link        String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([published, date])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String?
  userName  String?
  type      String
  label     String
  metadata  String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Indexes critiques — cette table grossit très vite
  @@index([createdAt])
  @@index([type])
  @@index([userId])
  @@index([type, createdAt])    // filtre admin par type + tri
  @@index([userId, createdAt])  // historique d'un user
}

model JobAlert {
  id        String   @id @default(cuid())
  userId    String
  keywords  String
  location  String?
  frequency String   @default("daily")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([active, frequency])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  token     String   @unique
  frequency String   @default("weekly")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([active, frequency])
}

model NewsletterCampaign {
  id             String   @id @default(cuid())
  subject        String
  content        String
  type           String   @default("manual")
  recipientCount Int      @default(0)
  sentAt         DateTime @default(now())
}

model JobTemplate {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  title        String
  description  String
  requirements String?
  benefits     String?
  type         String
  category     String
  location     String
  remote       Boolean  @default(false)
  salaryMin    Int?
  salaryMax    Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}
