# Base de données PostgreSQL (Supabase)
DATABASE_URL="postgresql://postgres.xxx:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxx:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="votre-secret-très-long-et-aléatoire"

# Google OAuth (optionnel)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (Resend)
RESEND_API_KEY=""
RESEND_FROM="KTZ Emploi <noreply@ktz-emploi.cf>"

# Anthropic (optionnel)
ANTHROPIC_API_KEY=""

# Admin
ADMIN_EMAIL="votre-email-admin@example.com"

# CORS — origines autorisées séparées par des virgules (laisser vide = NEXTAUTH_URL uniquement)
ALLOWED_ORIGINS=""
